# Variáveis de ambiente — Wishes App
# Copie este arquivo para .env.local e preencha os valores reais
# NUNCA commite .env.local no git

# ────────────────────────────────────────────
# CONVEX (gerado após rodar: npx convex dev)
# ────────────────────────────────────────────
VITE_CONVEX_URL=https://<seu-deployment>.convex.cloud

# ────────────────────────────────────────────
# CONVEX AUTH — definir também no dashboard do Convex
# ────────────────────────────────────────────
# Chave da API do Resend (https://resend.com)
AUTH_RESEND_KEY=re_...

# Secret aleatório de 32+ chars para assinar tokens de sessão
# gere com: openssl rand -base64 32
AUTH_SECRET=...

# ────────────────────────────────────────────
# STRIPE — definir também no dashboard do Convex
# ────────────────────────────────────────────
# Chave secreta (sk_test_ para sandbox, sk_live_ para produção)
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (gerado no dashboard do Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# ID do preço da assinatura mensal criado no Stripe
STRIPE_PRICE_ID=price_...

# ────────────────────────────────────────────
# CLAUDE — definir também no dashboard do Convex
# ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
